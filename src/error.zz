// error.zz — Error helpers for zimg.
//
// Uses str for error messages (ZZ has no user-defined enums).
// The C wrapper has a global error buffer (NOT thread-safe for reads).
// We capture the error string at the point of failure.

import ffi

// Capture the last error message from the C wrapper.
// Must be called from main thread (reads global error buffer).
func capture_error() -> str {
    msg_ptr := ffi.zimg_last_error()
    if msg_ptr != 0 {
        return str(msg_ptr)
    }
    return "unknown error"
}
