// ops.zz — Pillow-style one-shot operations.
// 
// Each op hides the full lifecycle: load → transform → save back to the
// same path (mogrify semantics) → close. Nothing raw leaks out.

import image

/// Scale factor fitting (cur_w, cur_h) inside (want_w, want_h),
/// aspect preserved.

func fit_scale(cur_w: int, cur_h: int, want_w: int, want_h: int) -> float {
    sx := float(want_w) / float(cur_w)
    sy := float(want_h) / float(cur_h)
    s := sx
    if sy < sx {
        s = sy
    }
    s
}

func angle_of(degrees: int) -> Result<int, str> {
    match degrees {
        90 => .ok(1)
        180 => .ok(2)
        270 => .ok(3)
        _ => .err("zimg.rotate supports 90, 180 or 270 degrees")
    }
}

func resized(handle: int, scale: float, path: str) -> Result<str, str> {
    match image.resize_to(handle, scale) {
        .err(e) => .err(e)
        .ok(h2) => saved(h2, path)
    }
}

func rotated(handle: int, angle: int, path: str) -> Result<str, str> {
    match image.rotate_by(handle, angle) {
        .err(e) => .err(e)
        .ok(h2) => saved(h2, path)
    }
}

func blurred(handle: int, sigma: float, path: str) -> Result<str, str> {
    match image.blur_by(handle, sigma) {
        .err(e) => .err(e)
        .ok(h2) => saved(h2, path)
    }
}

func saved(h2: int, path: str) -> Result<str, str> {
    match image.save_to(h2, path) {
        .err(e) => .err(e)
        .ok(out) => {
            image.close(h2)
            .ok(out)
        }
    }
}

/// Resize the image at `path`, saving back to the same path.
/// Returns the path on success.

/// Early range validation (mirrors the C walls): reject before FFI so
/// callers get `.err` without a native round-trip. NaN fails `>=` and is
/// rejected too.

func check_sigma(sigma: float) -> Result<float, str> {
    if sigma >= 0.0 {
        .ok(sigma)
    } else {
        .err("zimg: sigma must be non-negative")
    }
}

func check_quality(q: int) -> Result<int, str> {
    if q >= 0 {
        if q <= 100 {
            .ok(q)
        } else {
            .err("zimg: quality must be 0-100")
        }
    } else {
        .err("zimg: quality must be 0-100")
    }
}

func check_compression(c: int) -> Result<int, str> {
    if c >= 0 {
        if c <= 9 {
            .ok(c)
        } else {
            .err("zimg: compression must be 0-9")
        }
    } else {
        .err("zimg: compression must be 0-9")
    }
}

func check_dims(width: int, height: int) -> Result<int, str> {
    if width > 0 {
        if height > 0 {
            .ok(0)
        } else {
            .err("zimg: dimensions must be positive")
        }
    } else {
        .err("zimg: dimensions must be positive")
    }
}

pub func resize(path: str, width: int, height: int) -> Result<str, str> {
    match check_dims(width, height) {
        .err(e) => .err(e)
        .ok(_c) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => resized(h, fit_scale(image.width_of(h), image.height_of(h), width, height), path)
        }
    }
}

/// Rotate the image at `path` clockwise, saving back to the same path.
/// Returns the path on success.

pub func rotate(path: str, degrees: int) -> Result<str, str> {
    match angle_of(degrees) {
        .err(e) => .err(e)
        .ok(angle) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => rotated(h, angle, path)
        }
    }
}

/// Gaussian-blur the image at `path`, saving back to the same path.
/// Returns the path on success.

pub func blur(path: str, sigma: float) -> Result<str, str> {
    match check_sigma(sigma) {
        .err(e) => .err(e)
        .ok(s) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => blurred(h, s, path)
        }
    }
}

/// Thumbnail the image at `path` to fit inside (width, height), saving
/// back. crop_mode: "none" fits, "centre" fills exactly.

pub func thumbnail(path: str, width: int, height: int, crop_mode: str) -> Result<str, str> {
    match check_dims(width, height) {
        .err(e) => .err(e)
        .ok(_c) => match image.crop_mode_named(crop_mode) {
            .err(e) => .err(e)
            .ok(cm) => match image.load(path) {
                .err(e) => .err(e)
                .ok(h) => match image.thumbnail_to(h, width, height, cm) {
                    .err(e) => .err(e)
                    .ok(h2) => saved(h2, path)
                }
            }
        }
    }
}

/// Free-rotate the image at `path` by any angle (degrees, clockwise),
/// saving back. Background is transparent when the image has alpha,
/// else black.

pub func rotate_free(path: str, angle: float) -> Result<str, str> {
    match image.load(path) {
        .err(e) => .err(e)
        .ok(h) => match image.rotate_free_to(h, angle) {
            .err(e) => .err(e)
            .ok(h2) => saved(h2, path)
        }
    }
}

/// Free-rotate with explicit rgb background fill.

pub func rotate_bg(path: str, angle: float, r: int, g: int, b: int) -> Result<str, str> {
    match image.load(path) {
        .err(e) => .err(e)
        .ok(h) => match image.rotate_bg_to(h, angle, r, g, b) {
            .err(e) => .err(e)
            .ok(h2) => saved(h2, path)
        }
    }
}

/// Grayscale the image at `path`, saving back.

pub func grayscale(path: str) -> Result<str, str> {
    match image.load(path) {
        .err(e) => .err(e)
        .ok(h) => match image.grayscale(h) {
            .err(e) => .err(e)
            .ok(h2) => saved(h2, path)
        }
    }
}

/// Adjust brightness (levels, e.g. +10) and contrast (1.0 neutral).

pub func bright_contrast(path: str, brightness: float, contrast: float) -> Result<str, str> {
    match image.load(path) {
        .err(e) => .err(e)
        .ok(h) => match image.bright_contrast(h, brightness, contrast) {
            .err(e) => .err(e)
            .ok(h2) => saved(h2, path)
        }
    }
}

/// Sharpen the image at `path` (sigma), saving back.

pub func sharpen(path: str, sigma: float) -> Result<str, str> {
    match check_sigma(sigma) {
        .err(e) => .err(e)
        .ok(s) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.sharpen_by(h, s) {
                .err(e) => .err(e)
                .ok(h2) => saved(h2, path)
            }
        }
    }
}

/// Overlay `mark_path` onto the image at `path` at (x, y) with blend
/// mode ("over" default), saving back to `path`.

pub func watermark(path: str, mark_path: str, mode: str, x: int, y: int) -> Result<str, str> {
    match image.blend_named(mode) {
        .err(e) => .err(e)
        .ok(m) => match image.load(path) {
            .err(e) => .err(e)
            .ok(base) => match image.load(mark_path) {
                .err(e) => {
                    image.close(base)
                    .err(e)
                }
                .ok(mark) => match image.composite_onto(base, mark, m, x, y) {
                    .err(e) => {
                        image.close(base)
                        image.close(mark)
                        .err(e)
                    }
                    .ok(h2) => saved(h2, path)
                }
            }
        }
    }
}

/// Dimensions of the image at `path` as [width, height].
/// Loads, reads, closes — no file is modified.

pub func dims(path: str) -> Result<[int], str> {
    match image.load(path) {
        .err(e) => .err(e)
        .ok(h) => {
            d := [image.width_of(h), image.height_of(h)]
            image.close(h)
            .ok(d)
        }
    }
}

/// Flip the image at `path` ("horizontal" or "vertical"), saving back.

pub func flip(path: str, direction: str) -> Result<str, str> {
    match image.flip_named(direction) {
        .err(e) => .err(e)
        .ok(dir) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.flip_to(h, dir) {
                .err(e) => .err(e)
                .ok(h2) => saved(h2, path)
            }
        }
    }
}

/// Crop the image at `path` to (left, top, width, height), saving back.

pub func crop(path: str, left: int, top: int, width: int, height: int) -> Result<str, str> {
    match check_dims(width, height) {
        .err(e) => .err(e)
        .ok(_c) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.crop_to(h, left, top, width, height) {
                .err(e) => .err(e)
                .ok(h2) => saved(h2, path)
            }
        }
    }
}

/// Convert the image at `path` to a named colorspace
/// ("bw", "cmyk", "srgb", "grey16"), saving back.

pub func to_colorspace(path: str, name: str) -> Result<str, str> {
    match image.colorspace_named(name) {
        .err(e) => .err(e)
        .ok(cs) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.to_colorspace(h, cs) {
                .err(e) => .err(e)
                .ok(h2) => saved(h2, path)
            }
        }
    }
}

/// Resize with an explicit resampling kernel
/// ("nearest", "linear", "cubic", "mitchell", "lanczos2", "lanczos3").

pub func resize_kernel(path: str, width: int, height: int, kernel: str) -> Result<str, str> {
    match check_dims(width, height) {
        .err(e) => .err(e)
        .ok(_c) => match image.kernel_named(kernel) {
            .err(e) => .err(e)
            .ok(k) => match image.load(path) {
                .err(e) => .err(e)
                .ok(h) => match image.resize_kernel_to(h, fit_scale(image.width_of(h), image.height_of(h), width, height), k) {
                    .err(e) => .err(e)
                    .ok(h2) => saved(h2, path)
                }
            }
        }
    }
}
/// Save a copy in another format with a quality setting.

pub func save_jpeg(path: str, out: str, quality: int) -> Result<str, str> {
    match check_quality(quality) {
        .err(e) => .err(e)
        .ok(q) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.save_jpeg_to(h, out, q) {
                .err(e) => {
                    image.close(h)
                    .err(e)
                }
                .ok(p) => {
                    image.close(h)
                    .ok(p)
                }
            }
        }
    }
}

pub func save_png(path: str, out: str, compression: int) -> Result<str, str> {
    match check_compression(compression) {
        .err(e) => .err(e)
        .ok(c) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.save_png_to(h, out, c) {
                .err(e) => {
                    image.close(h)
                    .err(e)
                }
                .ok(p) => {
                    image.close(h)
                    .ok(p)
                }
            }
        }
    }
}

pub func save_webp(path: str, out: str, quality: int) -> Result<str, str> {
    match check_quality(quality) {
        .err(e) => .err(e)
        .ok(q) => match image.load(path) {
            .err(e) => .err(e)
            .ok(h) => match image.save_webp_to(h, out, q) {
                .err(e) => {
                    image.close(h)
                    .err(e)
                }
                .ok(p) => {
                    image.close(h)
                    .ok(p)
                }
            }
        }
    }
}
