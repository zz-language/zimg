// zimg.zz — package entry: the ergonomic public API.
//
// Consumers write `import zimg`, then `zimg.resize(...)` etc. All raw
// FFI (`zimg.raw.*`) stays inside image.zz / ops.zz.

import image
import ops

pub func resize(path: str, width: int, height: int) -> Result<str, str> {
    ops.resize(path, width, height)
}

pub func rotate(path: str, degrees: int) -> Result<str, str> {
    ops.rotate(path, degrees)
}

pub func blur(path: str, sigma: float) -> Result<str, str> {
    ops.blur(path, sigma)
}

/// Debug live-handle counter (produced minus released). Zero at exit.
pub func live_handles() -> int {
    image.live_handles()
}
