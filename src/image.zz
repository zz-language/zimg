// image.zz — single-owner handle pipeline over the raw layer.
//
// Why ints, not a struct: ZZ structs cannot cross into zz_value slots on
// the AOT path yet (pre-existing codegen gap), so the builder is a
// discipline, not a type: every transform takes an owned handle, releases
// it, and returns the fresh one. Never reuse a handle after passing it to
// a transform — use the returned one (move semantics by convention;
// stale ints dangle).
//
//   - `close()` releases a handle. Pair every chain with a close.
//   - `live_handles()` reports produced-minus-released process-wide;
//     tests assert zero at exit.
//   - Failures never touch the slot: the input handle stays valid.
//
// Init is automatic: the first load/create initializes libvips
// (vips_init is idempotent, and the slot is empty at that point by
// construction, so init can orphan nothing).
//
// Error model: every fallible op returns Result<_, str> with a static
// message (C detail strings cannot cross the boundary yet).

/// Debug live-handle counter (produced minus released). Zero at exit.
pub func live_handles() -> int {
    zimg_live_handles()
}

/// Tune the shared libvips worker pool (0 = default, CPU cores). The
/// pool is global and shared by all threads: ZZ threads submit work to
/// it rather than each spawning workers, so there is no
/// oversubscription by design. Call before heavy parallel use.
pub func set_workers(n: int) {
    zimg_set_concurrency(n)
}

func ensure_init() -> Result<int, str> {
    code := zimg_init()
    if code != 0 {
        return .err("zimg.init failed")
    }
    .ok(code)
}

/// Load an image file. Returns an owned handle.
pub func load(path: str) -> Result<int, str> {
    match ensure_init() {
        .err(e) => .err(e),
        .ok(_c) => match checked("zimg.load", zimg_load(path)) {
            .err(e) => .err(e),
            .ok(_c2) => .ok(zimg_get_result()),
        },
    }
}

/// Solid-color test image (no file I/O). Useful for tests.
pub func create_test(width: int, height: int, r: int, g: int, b: int) -> Result<int, str> {
    match ensure_init() {
        .err(e) => .err(e),
        .ok(_c) => match checked("zimg.create_test", zimg_create_test(width, height, r, g, b)) {
            .err(e) => .err(e),
            .ok(_c2) => .ok(zimg_get_result()),
        },
    }
}

func checked(op: str, code: int) -> Result<int, str> {
    match code {
        0 => .ok(code),
        _ => .err("{op} failed"),
    }
}

pub func width_of(handle: int) -> int {
    zimg_width(handle)
}

pub func height_of(handle: int) -> int {
    zimg_height(handle)
}

/// Shared replace step: on success, consume the previous handle and
/// return the fresh one. On failure the input handle stays valid.
func replace(op: str, handle: int, code: int) -> Result<int, str> {
    match checked(op, code) {
        .err(e) => .err(e),
        .ok(_c) => {
            next := zimg_get_result()
            zimg_release(handle)
            .ok(next)
        },
    }
}

pub func resize_to(handle: int, scale: float) -> Result<int, str> {
    replace("zimg.resize", handle, zimg_resize(handle, scale))
}

pub func blur_by(handle: int, sigma: float) -> Result<int, str> {
    replace("zimg.blur", handle, zimg_blur(handle, sigma))
}

pub func rotate_by(handle: int, angle: int) -> Result<int, str> {
    replace("zimg.rotate", handle, zimg_rot(handle, angle))
}

pub func flip_by(handle: int, direction: int) -> Result<int, str> {
    replace("zimg.flip", handle, zimg_flip(handle, direction))
}

pub func crop_to(handle: int, left: int, top: int, width: int, height: int) -> Result<int, str> {
    replace("zimg.crop", handle, zimg_crop(handle, left, top, width, height))
}

/// Save to path. Returns the path on success. Does not consume.
pub func save_to(handle: int, path: str) -> Result<str, str> {
    match checked("zimg.save", zimg_save(handle, path)) {
        .err(e) => .err(e),
        .ok(_c) => .ok(path),
    }
}

/// Release a handle. After close the value must not be used.
pub func close(handle: int) {
    zimg_release(handle)
}

/// Resampling kernels (VipsKernel ints).
pub func kernel_named(name: str) -> Result<int, str> {
    match name {
        "nearest" => .ok(0),
        "linear" => .ok(1),
        "cubic" => .ok(2),
        "mitchell" => .ok(3),
        "lanczos2" => .ok(4),
        "lanczos3" => .ok(5),
        _ => .err("unknown kernel"),
    }
}

pub func resize_kernel_to(handle: int, scale: float, kernel: int) -> Result<int, str> {
    replace("zimg.resize_kernel", handle, zimg_resize_kernel(handle, scale, kernel))
}

/// Thumbnail crop modes (VipsInteresting ints).
pub func crop_mode_named(name: str) -> Result<int, str> {
    match name {
        "none" => .ok(0),
        "centre" => .ok(1),
        "entropy" => .ok(2),
        "attention" => .ok(3),
        _ => .err("unknown crop mode"),
    }
}

/// Fit inside width×height; nonzero crop mode fills exactly.
pub func thumbnail_to(handle: int, width: int, height: int, crop: int) -> Result<int, str> {
    replace("zimg.thumbnail", handle, zimg_thumbnail(handle, width, height, crop))
}

/// Arbitrary-angle rotate (degrees, clockwise). Exact right angles take
/// the lossless path internally; other angles expand the canvas.
/// Background: transparent when the image has alpha, else black, unless
/// rgb is given (rotate_bg_to).
pub func rotate_free_to(handle: int, angle: float) -> Result<int, str> {
    replace("zimg.rotate_free", handle, zimg_rotate_free(handle, angle, 0, 0, 0, 0))
}

pub func rotate_bg_to(handle: int, angle: float, r: int, g: int, b: int) -> Result<int, str> {
    replace("zimg.rotate_free", handle, zimg_rotate_free(handle, angle, r, g, b, 1))
}

pub func grayscale(handle: int) -> Result<int, str> {
    replace("zimg.grayscale", handle, zimg_grayscale(handle))
}

/// Tone: out = in * contrast + brightness (brightness in levels,
/// e.g. +10 lifts; contrast 1.0 is neutral).
pub func bright_contrast(handle: int, brightness: float, contrast: float) -> Result<int, str> {
    replace("zimg.bright_contrast", handle, zimg_brightness_contrast(handle, brightness, contrast))
}

/// Curated colorspace names (VipsInterpretation ints).
pub func colorspace_named(name: str) -> Result<int, str> {
    match name {
        "bw" => .ok(1),
        "cmyk" => .ok(15),
        "srgb" => .ok(22),
        "grey16" => .ok(26),
        _ => .err("unknown colorspace"),
    }
}

pub func to_colorspace(handle: int, cs: int) -> Result<int, str> {
    replace("zimg.to_colorspace", handle, zimg_to_colorspace(handle, cs))
}

/// Sharpen (sigma). Auto-casts to sRGB first; sharpen rejects untagged
/// input internally, so synthetic images work without a manual cast.
pub func sharpen_by(handle: int, sigma: float) -> Result<int, str> {
    replace("zimg.sharpen", handle, zimg_sharpen(handle, sigma))
}

/// Blend modes (VipsBlendMode ints).
pub func blend_named(name: str) -> Result<int, str> {
    match name {
        "over" => .ok(2),
        "in" => .ok(3),
        "atop" => .ok(5),
        "xor" => .ok(11),
        "multiply" => .ok(14),
        _ => .err("unknown blend mode"),
    }
}

/// Shared two-handle replace (composite): on success the C side has
/// already consumed BOTH inputs — just adopt the result. On failure
/// both handles stay valid.
func replace2(op: str, code: int) -> Result<int, str> {
    match checked(op, code) {
        .err(e) => .err(e),
        .ok(_c) => .ok(zimg_get_result()),
    }
}

/// Overlay `mark` onto `base` at (x, y). Consumes both handles.
pub func composite_onto(base: int, mark: int, mode: int, x: int, y: int) -> Result<int, str> {
    replace2("zimg.composite", zimg_composite(base, mark, mode, x, y))
}

/// Format saves with quality params. Borrow the handle (no consume).
pub func save_jpeg_to(handle: int, path: str, quality: int) -> Result<str, str> {
    match checked("zimg.save_jpeg", zimg_save_jpeg(handle, path, quality)) {
        .err(e) => .err(e),
        .ok(_c) => .ok(path),
    }
}

pub func save_png_to(handle: int, path: str, compression: int) -> Result<str, str> {
    match checked("zimg.save_png", zimg_save_png(handle, path, compression)) {
        .err(e) => .err(e),
        .ok(_c) => .ok(path),
    }
}

pub func save_webp_to(handle: int, path: str, quality: int) -> Result<str, str> {
    match checked("zimg.save_webp", zimg_save_webp(handle, path, quality)) {
        .err(e) => .err(e),
        .ok(_c) => .ok(path),
    }
}
